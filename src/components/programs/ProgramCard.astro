---
import type { Program, Category } from '@lib/supabase';
import type { Language } from '@lib/i18n';
import ProgramPattern from './ProgramPattern.astro';

interface Props {
  program: Program;
  lang: Language;
  category?: Category | null;
  hideCategory?: boolean;
  homepageStyle?: boolean;
}

const { program, lang, category, hideCategory = false, homepageStyle = false } = Astro.props;

// Ensure slug exists
if (!program.slug) {
  console.error('[ProgramCard] Program missing slug:', program.id, program.title);
}

const programUrl = program.slug ? `/programs/${program.slug}` : '#';
const patternSeed = program.slug || program.id || program.title;
---

<a
  href={programUrl}
  class={`block transition-opacity hover:opacity-80 h-full flex flex-col program-card-link ${homepageStyle ? 'bg-blue-50 rounded-[25px] p-6' : 'card'}`}
  data-testid="program-card"
  data-program-slug={program.slug || ''}
  data-astro-reload
  rel="external"
>
  <ProgramPattern seed={patternSeed} title={program.title} size="card" class="flex-shrink-0" />

  {category && !hideCategory && (
    <div class="mb-3 flex-shrink-0">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm bg-white border border-gray-200 text-black">
        {category[`name_${lang}` as keyof Category] || category.name_en}
      </span>
    </div>
  )}

  {program.goal && (
    <p class="text-black text-sm mb-0 line-clamp-2 flex-grow">{program.goal}</p>
  )}
</a>
