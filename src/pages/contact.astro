---
import PageLayout from '@layouts/PageLayout.astro';
import ContactForm from '@components/forms/ContactForm.astro';
import { getTranslations, type Language, getLanguageFromCookie } from '@lib/i18n';

export const prerender = false; // SSR so Turnstile site key is available at runtime (same as form pages)

const lang = getLanguageFromCookie(Astro.cookies, Astro.url) || 'en';
const t = getTranslations(lang);
---

<PageLayout
  title={t.forms.contact.title}
  description="Get in touch with Plademy"
  lang={lang}
>
  <div class="container py-12">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold mb-4">{t.forms.contact.title}</h1>
        <p class="text-xl text-gray-600">
          Have questions? We'd love to hear from you.
        </p>
        <p class="mt-4 text-base text-gray-700" data-testid="contact-email">
          Email us at
          <a href="mailto:info@plademy.com" class="text-[#2841CF] font-semibold hover:underline">
            info@plademy.com
          </a>
        </p>
        <p class="mt-2 text-sm text-gray-500">
          Plademy Oy · Maria 01, Lapinlahdenkatu 16, 00180 Helsinki · Business-ID 3386328-3
        </p>
      </div>

      <div class="card">
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</PageLayout>

