---
import PageLayout from '@layouts/PageLayout.astro';
import { getTranslations, getLanguageFromCookie } from '@lib/i18n';
import { SOLUTION_SECTIONS, getSolutionsBySection } from '@/data/solutions';
import SolutionCard from '@components/solutions/SolutionCard.astro';

export const prerender = true;

const lang = getLanguageFromCookie(Astro.cookies, Astro.url) || 'en';
const t = getTranslations(lang);
---

<PageLayout
  title={t.solutions.title}
  description={t.solutions.description}
  lang={lang}
>
  <div class="container py-12" data-testid="solutions-page">
    <div class="mb-14 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{t.solutions.title}</h1>
      <p class="text-xl text-black">
        {t.solutions.description}
      </p>
    </div>

    <div class="space-y-20">
      {SOLUTION_SECTIONS.map((section) => {
        const items = getSolutionsBySection(section.id);
        if (items.length === 0) return null;

        return (
          <section aria-labelledby={`solutions-${section.id}`}>
            <div class="mb-8 max-w-3xl mx-auto text-center">
              <h2 id={`solutions-${section.id}`} class="text-3xl md:text-4xl font-bold mb-3">
                {section.title}
              </h2>
              <p class="text-lg text-gray-700">{section.description}</p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
              {items.map((item) => (
                <div class={item.featured ? 'md:col-span-2' : ''}>
                  <SolutionCard item={item} variant="page" />
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <div class="mt-20 text-center rounded-[30px] bg-[#F6F7FB] px-8 py-12">
      <h2 class="text-3xl font-bold mb-3">{t.solutions.ctaTitle}</h2>
      <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">{t.solutions.ctaDescription}</p>
      <a
        href="/start"
        class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-[#2841CF] text-white font-bold transition-colors hover:bg-black"
        style="font-family: 'Bricolage Grotesque', sans-serif;"
      >
        {t.solutions.ctaButton}
      </a>
    </div>
  </div>
</PageLayout>
